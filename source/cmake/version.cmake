# 所有应用版本均由 source/VERSION 生成。可由主 CMakeLists 或 cmake -P 调用。
get_filename_component(RCG_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(READ "${RCG_SOURCE_DIR}/VERSION" RCG_VERSION)
string(ASCII 239 187 191 RCG_UTF8_BOM)
string(REGEX REPLACE "^${RCG_UTF8_BOM}" "" RCG_VERSION "${RCG_VERSION}")
string(STRIP "${RCG_VERSION}" RCG_VERSION)
if(NOT RCG_VERSION MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")
    message(FATAL_ERROR "VERSION must contain three decimal components, for example major.minor.patch, without leading zeros")
endif()
set(RCG_VERSION_MAJOR "${CMAKE_MATCH_1}")
set(RCG_VERSION_MINOR "${CMAKE_MATCH_2}")
set(RCG_VERSION_PATCH "${CMAKE_MATCH_3}")
foreach(component IN ITEMS RCG_VERSION_MAJOR RCG_VERSION_MINOR RCG_VERSION_PATCH)
    string(LENGTH "${${component}}" digits)
    if(digits GREATER 5 OR ${component} GREATER 65535)
        message(FATAL_ERROR "VERSION components must be between 0 and 65535")
    endif()
endforeach()
set(RCG_VERSION_WINDOWS "${RCG_VERSION}.0")
set(RCG_VERSION_RESOURCE "${RCG_VERSION_MAJOR},${RCG_VERSION_MINOR},${RCG_VERSION_PATCH},0")
if(NOT DEFINED RCG_GENERATED_DIR)
    set(RCG_GENERATED_DIR "${CMAKE_CURRENT_BINARY_DIR}/generated")
endif()
get_filename_component(RCG_GENERATED_DIR "${RCG_GENERATED_DIR}" ABSOLUTE)
if(RCG_GENERATED_DIR STREQUAL RCG_SOURCE_DIR)
    message(FATAL_ERROR "Generated version files must not overwrite source templates")
endif()
file(MAKE_DIRECTORY "${RCG_GENERATED_DIR}")
file(TO_CMAKE_PATH "${RCG_GENERATED_DIR}/app.manifest" RCG_MANIFEST_PATH)
file(TO_CMAKE_PATH "${RCG_SOURCE_DIR}/app.ico" RCG_ICON_PATH)
file(TO_CMAKE_PATH "${RCG_SOURCE_DIR}/app-logo.png" RCG_LOGO_PATH)
foreach(template IN ITEMS version.h app.manifest resources.rc)
    configure_file("${RCG_SOURCE_DIR}/${template}.in" "${RCG_GENERATED_DIR}/${template}" @ONLY)
endforeach()
if(NOT CMAKE_SCRIPT_MODE_FILE)
    # 修改 VERSION 后，下一次 cmake --build 会自动重新配置并重建相关目标。
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${RCG_SOURCE_DIR}/VERSION")
endif()
